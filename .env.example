# path: .env.example
DEBUG=False
ALLOWED_HOSTS=
SECRET_KEY=
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/paper_plus

# Printed sales invoice header (leave a value empty to drop that line)
COMPANY_NAME=
COMPANY_LEGAL_NAME=
COMPANY_ECONOMIC_CODE=
COMPANY_REGISTRATION_NO=
COMPANY_NATIONAL_ID=
COMPANY_POSTAL_CODE=
COMPANY_PHONE=
COMPANY_ADDRESS=
COMPANY_FOOTER_NOTE=

# Hosting (production only)
# BACKUP_DIR=/home/USER/paper-plus-backups
# CSRF_TRUSTED_ORIGINS=https://your-domain.ir
# COOKIE_SECURE=True
# SSL_REDIRECT=False

# USD rate (D-080). Source name from apps/shared/exchange.py; URL only to point it elsewhere.
# A cPanel cron job runs: python manage.py fetch_usd_rate   (every 3 hours is plenty)
# USD_RATE_SOURCE=tgju
# USD_RATE_URL=
# USD_RATE_STALE_HOURS=12
