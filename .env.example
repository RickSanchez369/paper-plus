# Copy to .env and fill in. See deploy/HOSTIRAN.md.
DEBUG=False
SECRET_KEY=
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
# The live host runs SQLite (D-091). Absolute path, outside any web-served folder (mkdir data first).
DATABASE_URL=sqlite:////home/USER/paper-plus/data/db.sqlite3

# Turn on once https works on the domain.
SSL_REDIRECT=False

# Printed sales invoice header (leave a value empty to drop that line)
COMPANY_NAME=
COMPANY_LEGAL_NAME=
COMPANY_ECONOMIC_CODE=
COMPANY_REGISTRATION_NO=
COMPANY_NATIONAL_ID=
COMPANY_POSTAL_CODE=
COMPANY_PHONE=
COMPANY_ADDRESS=
COMPANY_FOOTER_NOTE=
# Printed sales invoice (D-088); blank = the default shown in core/settings.py
COMPANY_BRAND=
COMPANY_PHONES=
COMPANY_EMAIL=
COMPANY_INSTAGRAM=
COMPANY_TELEGRAM=
COMPANY_WHATSAPP=
COMPANY_TERMS=

# Optional hosting settings
# BACKUP_DIR=/home/USER/paper-plus-backups
# COOKIE_SECURE=True
# HSTS_SECONDS=0          # after HTTPS is final: 300, then 86400, then 31536000 (see deploy/CHECKLIST.md)
# STATIC_MAX_AGE=86400    # cache seconds for static files

# USD rate (D-080). Source name from apps/shared/exchange.py; URL only to point it elsewhere.
# A cPanel cron job runs: python manage.py fetch_usd_rate   (every 3 hours is plenty)
# USD_RATE_SOURCE=tgju
# USD_RATE_URL=
# USD_RATE_STALE_HOURS=12
